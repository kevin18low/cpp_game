# Normalize line endings: store LF in the repo, check out native endings.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.bmp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
